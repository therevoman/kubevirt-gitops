# Build parameters for Microsoft Windows 11 (ConfigMap windows-11-install-params; read by windows/build).
# OS is the name key: Job, VM, ServiceAccount and ConfigMaps are named windows-11-install*.
OS=11
BOOT_SOURCE=win11
OS_ID=windows11
OS_NAME=Microsoft Windows 11
WORKLOAD=desktop
EDITION=desktop
# virtio-win driver folder for this release
DRIVER_DIR=w11
# Edition by name; PRODUCT_KEY is Microsoft's public generic install key (selects the edition, does not activate)
IMAGE_KEY=/IMAGE/NAME
IMAGE_VALUE=Windows 11 Pro
PRODUCT_KEY=VK7JG-NPHTM-C97JM-9MPGT-3V66T
TPM=true
# Build disk and boot-source size; the windows11 templates clone this size, so it must not exceed it
DISK_SIZE=64Gi
# Fail when one step (e.g. a Windows Update round) shows no progress for this long
STALL_MIN=150
WU_MAX_ROUNDS=8
