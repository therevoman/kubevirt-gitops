# Build parameters for Microsoft Windows 10 (ConfigMap windows-10-install-params; read by windows/build).
# OS is the name key: Job, VM, ServiceAccount and ConfigMaps are named windows-10-install*.
OS=10
BOOT_SOURCE=win10
OS_ID=windows10
OS_NAME=Microsoft Windows 10
WORKLOAD=desktop
EDITION=desktop
# virtio-win driver folder for this release
DRIVER_DIR=w10
# Edition by name; PRODUCT_KEY is Microsoft's public generic install key (selects the edition, does not activate)
IMAGE_KEY=/IMAGE/NAME
IMAGE_VALUE=Windows 10 Pro
PRODUCT_KEY=VK7JG-NPHTM-C97JM-9MPGT-3V66T
TPM=false
# Build disk and boot-source size; the windows10 templates clone this size, so it must not exceed it
DISK_SIZE=60Gi
# Fail when one step (e.g. a Windows Update round) shows no progress for this long
STALL_MIN=150
WU_MAX_ROUNDS=8
# Monthly rebuild (CronJob windows-<OS>-rebuild, suspended unless the cluster turns it on):
# after Patch Tuesday (2nd Tuesday, day 8-14); each version on its own day
REBUILD_SCHEDULE=0 1 15 * *
