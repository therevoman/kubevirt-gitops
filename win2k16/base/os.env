# Build parameters for Microsoft Windows Server 2016 (ConfigMap windows-2k16-install-params; read by windows/build).
# OS is the name key: Job, VM, ServiceAccount and ConfigMaps are named windows-2k16-install*.
OS=2k16
BOOT_SOURCE=win2k16
OS_ID=windows2k16
OS_NAME=Microsoft Windows Server 2016
WORKLOAD=server
EDITION=server
# virtio-win driver folder for this release
DRIVER_DIR=2k16
# Server image index 2 = Standard (Desktop Experience); 1 is Server Core. No key: the ISO selects the edition
IMAGE_KEY=/IMAGE/INDEX
IMAGE_VALUE=2
PRODUCT_KEY=
TPM=false
# Build disk and boot-source size; the windows2k16 templates clone this size, so it must not exceed it
DISK_SIZE=60Gi
# Fail when one step (e.g. a Windows Update round) shows no progress for this long
STALL_MIN=240
WU_MAX_ROUNDS=12
# Monthly rebuild (CronJob windows-<OS>-rebuild, suspended unless the cluster turns it on):
# after Patch Tuesday (2nd Tuesday, day 8-14); each version on its own day
REBUILD_SCHEDULE=0 1 17 * *
